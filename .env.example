# Set to true only for local UI/testing without real app store billing.
# Leave unset or false for TestFlight/Play Console purchase testing.
EXPO_PUBLIC_USE_MOCK_PURCHASES=false

# Firebase Web App config (Project Settings -> General -> Your apps -> Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# OAuth client IDs used by expo-auth-session Google provider
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# AdMob ad unit IDs (used by src/utils/ads.js)
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID=

# RevenueCat API keys (required for in-app purchases)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
