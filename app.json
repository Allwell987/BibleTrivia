{
  "expo": {
    "name": "Bible Trivia",
    "slug": "bibletrivia",
    "version": "1.0.0",
    "sdkVersion": "55.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F0D0A",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bibletrivia.app",
      "infoPlist": {
        "CFBundleDisplayName": "Bible Trivia",
        "UILaunchStoryboardName": "SplashScreen",
        "NSPrivacyURL": "https://your-domain.com/privacy-policy",
        "NSPrivacyAccessedAPITypes": [
          "NSPrivacyAccessedAPICategoryUserDefaults"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0D0A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.bibletrivia.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "react-native-iap",
        {
          "skuAndroidList": [
            "com.iguruapp.bibletrivia.coins_250",
            "com.iguruapp.bibletrivia.coins_500",
            "com.iguruapp.bibletrivia.coins_1200",
            "com.iguruapp.bibletrivia.coins_3000",
            "com.iguruapp.bibletrivia.coins_7500"
          ],
          "skuIosList": [
            "com.iguruapp.bibletrivia.coins_250",
            "com.iguruapp.bibletrivia.coins_500",
            "com.iguruapp.bibletrivia.coins_1200",
            "com.iguruapp.bibletrivia.coins_3000",
            "com.iguruapp.bibletrivia.coins_7500"
          ]
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-video",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "6bbd4f40-2fec-4ee4-a02f-968da7251d72"
      }
    },
    "owner": "allwell8966"
  }
}
